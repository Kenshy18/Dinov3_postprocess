# Copy this file to configs/artifact_sources.env after cloning, then edit URLs.
# The setup script sources configs/artifact_sources.env automatically.

# Fill this after uploading artifacts_to_upload/runtime_artifacts to Google Drive.
# This is the preferred single-artifact source for the full end-to-end runtime.
# Expected Drive folder layout:
#   checkpoints/dinov3/detector/model_final.pth
#   checkpoints/dinov3/dinov3_vitl16_pretrain_lvd1689m-8aa4cbdd.pth
#   checkpoints/dinov3/classifier/best.pt
#   checkpoints/Eva02/detector/model_final.pth
#   checkpoints/Eva02/classifier/best.pt
#   checkpoints/codino/detector/epoch_2.pth
#   checkpoints/codino/classifier/best.pt
#   checkpoints/postprocess/k2_v5/best_exact.pt
#   checkpoints/postprocess/k2_v5/run_config.json
#   checkpoints/postprocess/k2_v5/train_k2_slot_set_spd_standalone_v5.py
#   checkpoints/postprocess/polygon_point_predictor/best.pt
#   checkpoints/postprocess/polygon_point_predictor/feature_stats.npz
#   checkpoints/postprocess/polygon_point_predictor/run_config.json
#   checkpoints/postprocess/polygon_point_predictor/train_mask_point_predictor.py
RUNTIME_ARTIFACTS_URL="https://drive.google.com/drive/folders/REPLACE_WITH_RUNTIME_ARTIFACTS_FOLDER"

# Optional local source instead of Google Drive.
# RUNTIME_ARTIFACTS_DIR="/path/to/runtime_artifacts"

# TensorRT engines are device-specific and are created or reused locally.
# Pin to a CUDA 12.8/driver 573 compatible TensorRT build by default.
TENSORRT_PIP_SPEC="tensorrt==10.13.0.35"

# PyTorch is auto-installed only when the selected runtime Python cannot import
# a CUDA-capable torch. Ada and older GPUs default to a stable torch 2.1/CUDA
# 12.1 stack because it has OpenMMLab mmcv-full 1.7.2 wheels. Blackwell defaults
# to PyTorch nightly CUDA 12.9; pass REFERENCE_VENV or override these values if
# your driver/CUDA stack needs a different build.
INSTALL_TORCH="auto"
# TORCH_PIP_SPEC="torch==2.1.2"
# TORCHVISION_PIP_SPEC="torchvision==0.16.2"
# TORCH_INDEX_URL="https://download.pytorch.org/whl/cu121"

# Co-DINO uses the old mmdet/mmcv 1.x stack. Setup first checks for working
# mmcv CUDA ops, then tries wheel-only install from OpenMMLab links, then source
# build only when ALLOW_MMCV_SOURCE_BUILD allows it and nvcc is available. On
# Ada and older GPUs, REPIN_TORCH_FOR_MMCV=auto allows setup to move a too-new
# project venv torch back to the portable torch 2.1/CUDA 12.1 wheel stack.
MMCV_FULL_VERSION="1.7.2"
REPIN_TORCH_FOR_MMCV="auto"
ALLOW_MMCV_SOURCE_BUILD="auto"
# MMCV_FULL_WHEEL="/path/to/mmcv_full-1.7.2-cp310-cp310-manylinux1_x86_64.whl"
# MMCV_FIND_LINKS="https://download.openmmlab.com/mmcv/dist/cu121/torch2.1/index.html"

REBUILD_TRT="auto"
REBUILD_CODINO_TRT="auto"
# auto creates Co-DINO fixed-batch engines for VRAM-appropriate candidates,
# then benchmarks DINOv3/EVA02/Co-DINO and writes the fastest local batch size
# to .runtime/runtime_profile.json.
CODINO_TRT_BATCH_SIZE="auto"
DINOV3_BATCH_CANDIDATES="auto"
EVA02_BATCH_CANDIDATES="auto"
CODINO_TRT_BATCH_CANDIDATES="auto"
BATCH_BENCHMARK_MAX_VRAM_FRACTION="0.95"
DOWNLOAD_ARTIFACTS="1"
ARTIFACT_OVERWRITE="0"
